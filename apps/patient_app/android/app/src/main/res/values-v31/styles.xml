<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+: the system draws its own splash first. Make it Asani forest green
         with the green "a" mark on a cream circle (DESIGN.md S-01, PRD D-25), same in dark mode. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowSplashScreenBackground">@color/asani_primary</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_splash</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@color/ic_launcher_background</item>
    </style>
</resources>
