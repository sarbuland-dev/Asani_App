<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+: the system draws its own splash first. Make it Asani teal
         with the white "a" mark (DESIGN.md S-01, PRD D-25), same in dark mode. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowSplashScreenBackground">@color/asani_primary</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_splash</item>
    </style>
</resources>
