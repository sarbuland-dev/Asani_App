{
  "name": "asani-functions",
  "private": true,
  "description": "Asani Cloud Functions (ARCHITECTURE.md §5). Region asia-south1.",
  "main": "lib/index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "lint": "tsc --noEmit -p tsconfig.json",
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test lib/",
    "serve:dev": "npm run build && firebase emulators:start --only functions --project asani-b2b17",
    "test:rules": "firebase emulators:exec --only firestore --project demo-asani-rules \"node --test test/rules/\""
  },
  "dependencies": {
    "firebase-admin": "^13.0.0",
    "firebase-functions": "^6.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0",
    "@firebase/rules-unit-testing": "^4.0.0",
    "firebase": "^11.0.0"
  }
}
